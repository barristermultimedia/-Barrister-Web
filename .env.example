# Set these in Netlify: Site configuration > Environment variables. Never commit real values.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-long-password
SESSION_SECRET=at-least-16-random-characters
TIMEZONE=Africa/Accra
# Gmail alerts (use a Google App Password, not your normal password)
GMAIL_USER=yourname@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
NOTIFY_EMAIL=yourname@gmail.com
# WhatsApp alerts via CallMeBot (free), international format without +
WHATSAPP_PHONE=233201234567
CALLMEBOT_APIKEY=123456
# Or use your own gateway instead (Twilio, Make, Zapier...):
# WHATSAPP_WEBHOOK_URL=https://example.com/hook
